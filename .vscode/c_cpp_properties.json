{
  "version": 4,
  "configurations": [
    {
      "name": "Linux host (WSL)",
      "compilerPath": "/usr/bin/gcc",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c11",
      "defines": ["_DEFAULT_SOURCE"],
      "includePath": ["${workspaceFolder}/firmware/c"]
    },
    {
      "name": "CM4 AArch64 (WSL)",
      "compilerPath": "/usr/bin/aarch64-linux-gnu-gcc",
      "intelliSenseMode": "linux-gcc-arm64",
      "cStandard": "c11",
      "defines": ["_DEFAULT_SOURCE"],
      "includePath": ["${workspaceFolder}/firmware/c", "${workspaceFolder}/build/linux-uapi/include"]
    }
  ]
}
